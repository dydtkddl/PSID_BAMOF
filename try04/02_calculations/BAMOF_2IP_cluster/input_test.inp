! ============================================================
! try04 / Case A1: BA-MOF + 2 Ion Pairs (Cluster/Associated)
! Purpose: E_cluster(2IP) for dilute-limit validation
! Atoms: 192 (MOF:102 fixed + unfixed:22 + IP#1:34 + IP#2:34)
! Method: PBE-D3/DZVP-MOLOPT-SR-GTH, GPW, 640 Ry cutoff
! All parameters identical to try03 except:
!   - 192 atoms (was 158)
!   - ADDED_MOS 170 (was 100)
!   - External XYZ file (was inline COORD)
!   - Fresh input (was restart)
! ============================================================

&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME BAMOF_2IP_cluster
  RUN_TYPE GEO_OPT
  SAVE_MEM T
&END GLOBAL

&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 2
    MAX_DR    1.0E-3
    MAX_FORCE 4.5E-4
    RMS_DR    5.0E-4
    RMS_FORCE 3.0E-4
  &END GEO_OPT
  &CONSTRAINT
    &FIXED_ATOMS
      COMPONENTS_TO_FIX XYZ
      LIST 1..102
    &END FIXED_ATOMS
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      &EACH
        GEO_OPT 1
      &END EACH
    &END TRAJECTORY
    &RESTART
      BACKUP_COPIES 1
      &EACH
        GEO_OPT 1
      &END EACH
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1

    &SCF
      MAX_SCF 200
      EPS_SCF 5.0E-7
      SCF_GUESS ATOMIC
      ADDED_MOS 170
      &DIAGONALIZATION T
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &SMEAR T
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &MIXING T
        METHOD BROYDEN_MIXING
        ALPHA 0.15
      &END MIXING
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF

    &QS
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
      METHOD GPW
    &END QS

    &MGRID
      CUTOFF 640
      REL_CUTOFF 40
    &END MGRID

    &XC
      DENSITY_CUTOFF  1.0E-10
      GRADIENT_CUTOFF 1.0E-10
      TAU_CUTOFF      1.0E-10
      &XC_FUNCTIONAL NO_SHORTCUT
        &PBE T
        &END PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          CALCULATE_C9_TERM T
          LONG_RANGE_CORRECTION T
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      A  16.00  -0.557   0.090
      B  -6.517  14.613  -0.057
      C  -4.635  -7.066  13.095
      PERIODIC XYZ
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME BAMOF_2IP_cluster_init.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    ! Pseudopotentials: inline definitions from try03 restart
    ! (bit-identical to try03 계산)
    &KIND Ti
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT Ti
      POTENTIAL GTH-PBE
      &POTENTIAL
        4 6 2
         3.8000000000000000E-001 2  8.7114421800000006E+000 -7.0028676999999995E-001
        3
         3.3777077999999999E-001 2  2.5752638600000002E+000  3.6929706499999999E+000
                                                             -4.7676046100000002E+000
         2.4253135000000001E-001 2 -4.6305412300000004E+000  8.8708750199999997E+000
                                                             -1.0496160870000001E+001
         2.4331694000000001E-001 1 -9.4066526800000005E+000
      &END POTENTIAL
    &END KIND

    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT C
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 2
         3.3847124000000001E-001 2 -8.8036739799999992E+000  1.3392108500000000E+000
        2
         3.0257574999999998E-001 1  9.6224866500000008E+000
         2.9150693999999999E-001 0
      &END POTENTIAL
    &END KIND

    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT H
      POTENTIAL GTH-PBE
      &POTENTIAL
        1
         2.0000000000000001E-001 2 -4.1789004399999996E+000  7.2446330999999997E-001
        0
      &END POTENTIAL
    &END KIND

    &KIND N
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT N
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 3
         2.8379051000000000E-001 2 -1.2415225590000000E+001  1.8680959200000000E+000
        2
         2.5540499999999999E-001 1  1.3630262569999999E+001
         2.4549452999999999E-001 0
      &END POTENTIAL
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT O
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 4
         2.4455430000000000E-001 2 -1.6667214800000000E+001  2.4873113199999999E+000
        2
         2.2095592000000000E-001 1  1.8337458110000000E+001
         2.1133246999999999E-001 0
      &END POTENTIAL
    &END KIND

    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT S
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 4
         4.1999999999999998E-001 1 -5.9862603800000000E+000
        2
         3.6482035000000002E-001 2  1.3143544479999999E+001 -4.2418304500000001E+000
                                                              5.4761795700000002E+000
         4.0948047999999998E-001 1  3.7008905699999999E+000
      &END POTENTIAL
    &END KIND

    &KIND F
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT F
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 5
         2.1492959000000000E-001 2 -2.1573028359999999E+001  3.1997761499999999E+000
        2
         1.9468402000000001E-001 1  2.3743540450000001E+001
         1.8615608000000000E-001 0
      &END POTENTIAL
    &END KIND

  &END SUBSYS
&END FORCE_EVAL

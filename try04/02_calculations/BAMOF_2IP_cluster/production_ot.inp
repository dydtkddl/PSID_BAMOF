&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME BAMOF_2IP_cluster
  RUN_TYPE GEO_OPT
  SAVE_MEM T
&END GLOBAL

&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 600
    MAX_DR    1.0E-3
    MAX_FORCE 4.5E-4
    RMS_DR    5.0E-4
    RMS_FORCE 3.0E-4
    STEP_START_VAL 2
  &END GEO_OPT
  &CONSTRAINT
    &FIXED_ATOMS
      COMPONENTS_TO_FIX XYZ
      LIST 1..102
    &END FIXED_ATOMS
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      &EACH
        GEO_OPT 1
      &END EACH
    &END TRAJECTORY
    &RESTART
      BACKUP_COPIES 1
      &EACH
        GEO_OPT 1
      &END EACH
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1
    WFN_RESTART_FILE_NAME BAMOF_2IP_cluster-RESTART.wfn

    &SCF
      MAX_SCF 300
      EPS_SCF 5.0E-7
      SCF_GUESS RESTART
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        ENERGY_GAP 0.01
      &END OT
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 5.0E-7
      &END OUTER_SCF
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF

    &QS
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
      METHOD GPW
    &END QS

    &MGRID
      CUTOFF 640
      REL_CUTOFF 40
    &END MGRID

    &XC
      DENSITY_CUTOFF  1.0E-10
      GRADIENT_CUTOFF 1.0E-10
      TAU_CUTOFF      1.0E-10
      &XC_FUNCTIONAL NO_SHORTCUT
        &PBE T
        &END PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          CALCULATE_C9_TERM T
          LONG_RANGE_CORRECTION T
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      A  16.00  -0.557   0.090
      B  -6.517  14.613  -0.057
      C  -4.635  -7.066  13.095
      PERIODIC XYZ
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME BAMOF_2IP_cluster_init.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND Ti
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT Ti
      POTENTIAL GTH-PBE
      &POTENTIAL
        4 6 2
         0.38000000 2  8.71144218 -0.70028677
        3
         0.33777078 2  2.57526386  3.69297065
                                  -4.76760461
         0.24253135 2 -4.63054123  8.87087502
                                  -10.49616087
         0.24331694 1 -9.40665268
      &END POTENTIAL
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT C
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 2
         0.33847124 2 -8.80367398  1.33921085
        2
         0.30257575 1  9.62248665
         0.29150694 0
      &END POTENTIAL
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT H
      POTENTIAL GTH-PBE
      &POTENTIAL
        1
         0.20000000 2 -4.17890044  0.72446331
        0
      &END POTENTIAL
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT N
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 3
         0.28379051 2 -12.41522559  1.86809592
        2
         0.25540500 1  13.63026257
         0.24549453 0
      &END POTENTIAL
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT O
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 4
         0.24455430 2 -16.66721480  2.48731132
        2
         0.22095592 1  18.33745811
         0.21133247 0
      &END POTENTIAL
    &END KIND
    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT S
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 4
         0.42000000 1 -5.98626038
        2
         0.36482035 2  13.14354448 -4.24183045
                                     5.47617957
         0.40948048 1  3.70089057
      &END POTENTIAL
    &END KIND
    &KIND F
      BASIS_SET DZVP-MOLOPT-SR-GTH
      ELEMENT F
      POTENTIAL GTH-PBE
      &POTENTIAL
        2 5
         0.21492959 2 -21.57302836  3.19977615
        2
         0.19468402 1  23.74354045
         0.18615608 0
      &END POTENTIAL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

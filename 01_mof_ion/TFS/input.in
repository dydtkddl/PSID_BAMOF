&CONTROL
  calculation = 'relax'    
  restart_mode ='from_scratch' 
  prefix = 'MIL125_NH2_convtest'  
  outdir = './tmp'       
  pseudo_dir = '/home/ys/PSID_SIMULATION_TOOLS/qe/qepseudo/SSSP_1.3.0_PBE_efficiency/'
  verbosity = 'high'      
  max_seconds   =  1.72800e+06 
  nstep = 300
  wf_collect = .true.
/
&SYSTEM
  a = 3.0000e+01
  ibrav = 1          
  nat = 15
  ntyp = 5            
  ecutwfc = 80   
  ecutrho = 640
  occupations = 'smearing'   
  degauss = 0.05
  nosym = .TRUE.
  vdw_corr='grimme-d3'
/
&ELECTRONS
  conv_thr = 1.0e-7
  electron_maxstep = 200
  mixing_beta = 0.2
  diagonalization = 'david'  
  startingwfc = "atomic+random"
  startingpot = "atomic"
/
&ions  
  ion_dynamics = 'bfgs'  
/ 
&CELL
  cell_dynamics = 'bfgs'
/


       GRADIENT_CUTOFF  9.9999999999999995E-008
       TAU_CUTOFF  9.9999999999999995E-008
       &XC_FUNCTIONAL NO_SHORTCUT
         &PBE T
         &END PBE
       &END XC_FUNCTIONAL
       &VDW_POTENTIAL
         POTENTIAL_TYPE PAIR_POTENTIAL
         &PAIR_POTENTIAL
           TYPE DFTD3
           PARAMETER_FILE_NAME dftd3.dat
           REFERENCE_FUNCTIONAL "PBE"
           CALCULATE_C9_TERM T
           LONG_RANGE_CORRECTION T
         &END PAIR_POTENTIAL
       &END VDW_POTENTIAL
     &END XC

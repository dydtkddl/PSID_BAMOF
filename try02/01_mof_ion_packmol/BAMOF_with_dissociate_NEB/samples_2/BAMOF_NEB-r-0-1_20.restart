       GRADIENT_CUTOFF  9.9999999999999995E-008
       TAU_CUTOFF  9.9999999999999995E-008
       &XC_FUNCTIONAL NO_SHORTCUT
         &PBE T
         &END PBE
       &END XC_FUNCTIONAL

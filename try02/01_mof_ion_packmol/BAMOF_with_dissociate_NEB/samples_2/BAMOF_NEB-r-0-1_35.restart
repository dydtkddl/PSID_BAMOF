     &END REPLICA
   &END BAND
 &END MOTION
 &FORCE_EVAL
   METHOD QS
   &DFT
     BASIS_SET_FILE_NAME BASIS_MOLOPT
     POTENTIAL_FILE_NAME GTH_POTENTIALS
     &SCF
       MAX_SCF 200
       EPS_SCF  5.0000000000000002E-005
       SCF_GUESS RESTART
       ADDED_MOS 100
       &DIAGONALIZATION T
         ALGORITHM STANDARD
       &END DIAGONALIZATION
       &SMEAR T
         METHOD FERMI_DIRAC
         ELECTRONIC_TEMPERATURE  1.0000000000000000E+003
       &END SMEAR
       &MIXING T
         METHOD BROYDEN_MIXING
         ALPHA  1.4999999999999999E-001
       &END MIXING
     &END SCF
     &QS
       METHOD GPW
       &SE
         &MEMORY
           EPS_STORAGE  1.0000000000000000E-010
           MAX_MEMORY 500
           COMPRESS T
         &END MEMORY
       &END SE
     &END QS
     &MGRID
       CUTOFF  6.4000000000000000E+002
       REL_CUTOFF  4.0000000000000000E+001
     &END MGRID
     &XC
       DENSITY_CUTOFF  9.9999999999999995E-008
       GRADIENT_CUTOFF  9.9999999999999995E-008
       TAU_CUTOFF  9.9999999999999995E-008
       &XC_FUNCTIONAL NO_SHORTCUT
         &PBE T
         &END PBE
       &END XC_FUNCTIONAL
       &VDW_POTENTIAL
         POTENTIAL_TYPE PAIR_POTENTIAL
         &PAIR_POTENTIAL
           TYPE DFTD3
           PARAMETER_FILE_NAME dftd3.dat
           REFERENCE_FUNCTIONAL "PBE"
           CALCULATE_C9_TERM T
           LONG_RANGE_CORRECTION T
         &END PAIR_POTENTIAL
       &END VDW_POTENTIAL
     &END XC
   &END DFT

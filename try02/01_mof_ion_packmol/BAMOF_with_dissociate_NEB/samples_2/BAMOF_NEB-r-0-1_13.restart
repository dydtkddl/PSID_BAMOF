 &END MOTION
 &FORCE_EVAL
   METHOD QS
   &DFT
     BASIS_SET_FILE_NAME BASIS_MOLOPT
     POTENTIAL_FILE_NAME GTH_POTENTIALS
     &SCF
       MAX_SCF 200
       EPS_SCF  5.0000000000000002E-005
       SCF_GUESS RESTART
       ADDED_MOS 100
       &DIAGONALIZATION T
         ALGORITHM STANDARD
       &END DIAGONALIZATION
       &SMEAR T
         METHOD FERMI_DIRAC
         ELECTRONIC_TEMPERATURE  1.0000000000000000E+003
       &END SMEAR
       &MIXING T
         METHOD BROYDEN_MIXING
         ALPHA  1.4999999999999999E-001
       &END MIXING
     &END SCF
     &QS
       METHOD GPW
       &SE
         &MEMORY
           EPS_STORAGE  1.0000000000000000E-010
           MAX_MEMORY 500
           COMPRESS T
         &END MEMORY
       &END SE
     &END QS

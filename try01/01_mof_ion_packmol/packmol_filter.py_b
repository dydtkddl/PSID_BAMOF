#!/usr/bin/env python3
"""
packmol_filter.py

Filter out molecules overlapping a periodic MOF framework.
Given a combined XYZ (MOF atoms followed by identical molecules),
map each molecule into the primitive cell, exclude any that overlap the MOF,
and save:
 1) each non-overlapping molecule as XYZ
 2) each non-overlapping molecule plus the original MOF as CIF
Logs each step and each molecule result.

Usage:
    python packmol_filter.py \
        mof.cif combined.xyz molecule.xyz outdir [cutoff]
"""
import os
import sys
import math
import numpy as np
import argparse
from ase.io import read, write
from ase.atoms import Atoms, Atom


def parse_args():
    parser = argparse.ArgumentParser(
        description='Filter molecules overlapping a periodic MOF')
    parser.add_argument('mof_cif', help='MOF primitive-cell CIF')
    parser.add_argument('combined_xyz', help='Combined XYZ: MOF + molecules')
    parser.add_argument('molecule_xyz', help='Single-molecule XYZ (for atom count)')
    parser.add_argument('outdir', help='Output directory')
    parser.add_argument('cutoff', nargs='?', type=float, default=2.0,
                        help='Distance cutoff in Å')
    return parser.parse_args()


def load_mof(cif_path):
    print(f"Loading MOF CIF: {cif_path}")
    mof = read(cif_path)
    cell = np.array(mof.get_cell())
    print(f"MOF cell:")
    print(cell)
    mof.set_pbc([True, True, True])
    return mof, cell


def split_combined(combined_xyz, n_mof, n_mol):
    print(f"Reading combined XYZ: {combined_xyz}")
    all_atoms = read(combined_xyz)
    total_atoms = len(all_atoms)
    print(f"Total atoms: {total_atoms}")
    if total_atoms < n_mof:
        print("Error: Combined file has fewer atoms than MOF block.")
        sys.exit(1)
    mof_atoms = Atoms(all_atoms[:n_mof])
    mols = []
    start = n_mof
    while start + n_mol <= total_atoms:
        mols.append(Atoms(all_atoms[start:start+n_mol]))
        start += n_mol
    print(f"Found {len(mols)} molecule blocks of {n_mol} atoms")
    return mof_atoms, mols


def wrap_coords(coords, cell):
    inv = np.linalg.inv(cell)
    frac = inv.dot(coords.T).T % 1.0
    return (cell.dot(frac.T)).T


def min_image_dist2(p, q, cell, inv_cell):
    delta = p - q
    frac = inv_cell.dot(delta)
    frac -= np.round(frac)
    dmin = cell.dot(frac)
    return np.dot(dmin, dmin)


def molecule_overlaps(molecule, mof_wrapped, cell, cutoff2, inv_cell):
    # wrap each molecule atom individually
    coords = molecule.get_positions()
    mapped = wrap_coords(coords, cell)
    overlap_atoms = []
    global_min = float('inf')
    # check each atom
    for i, p in enumerate(mapped, start=1):
        d2_list = [min_image_dist2(p, q, cell, inv_cell) for q in mof_wrapped]
        min_d2 = min(d2_list)
        global_min = min(global_min, min_d2)
        if min_d2 < cutoff2:
            overlap_atoms.append((i, math.sqrt(min_d2)))
    if overlap_atoms:
        print(f"    --> Overlaps detected: {len(overlap_atoms)} atoms (< cutoff {math.sqrt(cutoff2):.3f} Å)")
        for i, dist in overlap_atoms:
            print(f"        Atom {i}: dist = {dist:.3f} Å")
        worst = min(overlap_atoms, key=lambda x: x[1])
        print(f"    --> Worst overlap: Atom {worst[0]} at {worst[1]:.3f} Å")
        return True
    else:
        print(f"    No overlaps. Closest distance = {math.sqrt(global_min):.3f} Å")
        return False


def main():
    args = parse_args()
    os.makedirs(args.outdir, exist_ok=True)

    # Load MOF and cell
    mof, cell = load_mof(args.mof_cif)
    inv_cell = np.linalg.inv(cell)
    # wrap MOF once
    mof_wrapped = wrap_coords(mof.get_positions(), cell)

    # Determine atom counts
    single = read(args.molecule_xyz)
    n_mol = len(single)
    combined_atoms = read(args.combined_xyz)
    total = len(combined_atoms)
    n_mof = total % n_mol if total % n_mol != 0 else n_mol
    print(f"Inferred MOF atoms: {n_mof}, molecule atoms: {n_mol}")

    # Split
    mof_atoms, molecules = split_combined(args.combined_xyz, n_mof, n_mol)

    cutoff2 = args.cutoff**2
    keep_list = []
    print("Checking each molecule for overlap...")
    for idx, mol in enumerate(molecules, start=1):
        print(f"Molecule {idx}/{len(molecules)}")
        ov = molecule_overlaps(mol, mof_wrapped, cell, cutoff2, inv_cell)
        keep = not ov
        print(f"    Keep molecule? {keep}\n")
        keep_list.append(keep)

    # Save outputs
    print("Saving non-overlapping molecules...")
    count = 0
    for idx, keep in enumerate(keep_list, start=1):
        if not keep:
            continue
        count += 1
        mol = molecules[idx-1]
        # Save XYZ
        xyz_path = os.path.join(args.outdir, f"mol_{count:03d}.xyz")
        write(xyz_path, mol)
        print(f"  Saved molecule XYZ: {xyz_path}")
                # Save CIF: include periodic images for molecule
        print("  Building periodic images for molecule in CIF...")
        combo = Atoms(cell=cell, pbc=True)
        # add original MOF
        for atom in mof:
            combo.append(atom)
        # map molecule fractional positions
        frac = np.linalg.inv(cell).dot(mol.get_positions().T).T % 1.0
        # consider shifts in each direction
        shifts = [(i,j,k) for i in (-1,0,1) for j in (-1,0,1) for k in (-1,0,1)]
        for idx_atom, atom in enumerate(mol):
            for sx,sy,sz in shifts:
                f = frac[idx_atom] + np.array([sx,sy,sz])
                cart = cell.dot(f)
                combo.append(atom.__class__(atom.symbol, cart))
        cif_path = os.path.join(args.outdir, f"combo_{count:03d}.cif")
        write(cif_path, combo, format='cif')
        print(f"  Saved combo CIF with periodic images: {cif_path}"))

    print(f"Done: {count} molecules saved.")

if __name__ == '__main__':
    main()





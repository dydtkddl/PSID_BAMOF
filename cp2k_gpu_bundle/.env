# Project identity
PROJECT_NAME=keti-naion-sulfone
RUNBOOK_VERSION=1.0.0
TZ=Asia/Seoul

# Host user mapping
UID=1000
GID=1000
USER_NAME=operator

# GPU / container policy
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
CUDA_VERSION=12.8

# Image tags
BASE_IMAGE_TAG=keti/base:1.0.0
GMX_IMAGE_TAG=keti/gmx:2025.4-cuda12.8
ANALYSIS_IMAGE_TAG=keti/analysis:1.0.0
CP2K_IMAGE_TAG=keti/cp2k:2025.2-gpu
CP2K_BASE_IMAGE=cp2k/cp2k:2024.3_openmpi_generic_cuda_P100_psmp

# Tools versions
PYTHON_VERSION=3.11
PACKMOL_VERSION=21.2.0
ACPYPE_VERSION=2023.10.27
PYSCF_VERSION=2.12.1
GPU4PYSCF_VERSION=1.6.0
MDA_VERSION=2.9.0
ASE_VERSION=3.28.0
GEOMETRIC_VERSION=1.1

# Paths
PROJECT_ROOT=/workspace
DATA_ROOT=/workspace/data
INPUT_ROOT=/workspace/inputs
RUN_ROOT=/workspace/runs
RESULTS_ROOT=/workspace/results
LOG_ROOT=/workspace/logs

# Study lock
STUDY_LOCK_FILE=/workspace/study_lock.yml

# Progress/logging
DEFAULT_VERBOSE=1
DEFAULT_QUIET=0
DEFAULT_NO_PROGRESS=0
STALL_WARNING_MINUTES=10
HEARTBEAT_SECONDS=60

# GROMACS resources
GMX_GPU_ID=0
GMX_NTOMP=16
GMX_PIN=on
GMX_PME_GPU=1
GMX_UPDATE_GPU=1

# CP2K resources
CP2K_MPI_RANKS=8
CP2K_OMP_THREADS=8
CP2K_WALL_HOURS=24

# PySCF resources
PYSCF_MAX_MEMORY_MB=192000
PYSCF_NUM_THREADS=32
PYSCF_USE_GPU=1

# Operator defaults
# <!-- REVIEW-FIX M-04 -->
DEFAULT_SYSTEMS=T1-01_EC-DMC,T1-02_EC-DVS,T1-03_EC-DMS
DEFAULT_FROM_STAGE=step0
DEFAULT_TO_STAGE=all
CLASSICAL_SEEDS_PER_SYSTEM=3
AIMD_SEEDS_PER_SYSTEM=2

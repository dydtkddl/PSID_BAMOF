 &GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME "BAMOF"
   RUN_TYPE ENERGY
   SAVE_MEM T
 &END GLOBAL
 &FORCE_EVAL
   METHOD QS
   STRESS_TENSOR ANALYTICAL
   &DFT
     BASIS_SET_FILE_NAME BASIS_MOLOPT
     POTENTIAL_FILE_NAME GTH_POTENTIALS
     &SCF
       MAX_SCF 200
       EPS_SCF  4.9999999999999998E-007
       SCF_GUESS ATOMIC
       ADDED_MOS 100
       &DIAGONALIZATION T
         ALGORITHM STANDARD
       &END DIAGONALIZATION
       &SMEAR T
         METHOD FERMI_DIRAC
         ELECTRONIC_TEMPERATURE  3.0000000000000000E+002
       &END SMEAR
       &MIXING T
         METHOD BROYDEN_MIXING
         ALPHA  1.4999999999999999E-001
       &END MIXING
     &END SCF
     &QS
       EXTRAPOLATION ASPC
       EXTRAPOLATION_ORDER 3
       METHOD GPW
       &SE
         &MEMORY
           EPS_STORAGE  1.0000000000000000E-010
           MAX_MEMORY 500
           COMPRESS T
         &END MEMORY
       &END SE
     &END QS
     &MGRID
       CUTOFF  6.4000000000000000E+002
       REL_CUTOFF  4.0000000000000000E+001
     &END MGRID
     &XC
       DENSITY_CUTOFF  9.9999999999999991E-011
       GRADIENT_CUTOFF  9.9999999999999991E-011
       TAU_CUTOFF  9.9999999999999991E-011
       &XC_FUNCTIONAL NO_SHORTCUT
         &PBE T
         &END PBE
       &END XC_FUNCTIONAL
       &VDW_POTENTIAL
         POTENTIAL_TYPE PAIR_POTENTIAL
         &PAIR_POTENTIAL
           TYPE DFTD3
           PARAMETER_FILE_NAME dftd3.dat
           REFERENCE_FUNCTIONAL "PBE"
           CALCULATE_C9_TERM T
           LONG_RANGE_CORRECTION T
         &END PAIR_POTENTIAL
       &END VDW_POTENTIAL
     &END XC
   &END DFT
   &SUBSYS
     &CELL
